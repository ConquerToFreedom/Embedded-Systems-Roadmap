{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build UART polling TX",
            "type": "shell",
            "command": "mingw32-make",
            "options": {
                "cwd": "${workspaceFolder}/01_uart_polling_tx/firmware"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "Flash with CubeProgrammer",
            "type": "shell",
            "command": "STM32_Programmer_CLI.exe",
            "args": [
                "-c", "port=SWD",
                "-w", "${workspaceFolder}/01_uart_polling_tx/firmware/main.elf",
                "-v",
                "-rst"
            ],
            "options": {
                "env": {
                    "PATH": "${env:PATH};C:/Program Files/STMicroelectronics/STM32Cube/STM32CubeProgrammer/bin"
                }
            },
            "dependsOn": ["Build UART polling TX"],
            "problemMatcher": [],
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}